# Copiar a .env y completar. El .env real nunca se sube al repositorio.
# Toda la configuración se valida al arrancar (ver config.py).

# --- Canal ---
TELEGRAM_BOT_TOKEN=
# IDs numéricos de Telegram autorizados, separados por comas. Vacío = nadie.
# Para saber tu ID, escríbele al bot: si no estás autorizado te lo responde.
TELEGRAM_USUARIOS_PERMITIDOS=

# --- Proveedor de IA ---
# LLM_PROVIDER: nvidia (por defecto) | openai_compatible | azure_openai
#   nvidia            -> URL y modelo por defecto; apaga el razonamiento del modelo.
#   openai_compatible -> cualquier servicio con la API de OpenAI (p. ej. un NIM
#                        propio). Exige LLM_BASE_URL y LLM_MODEL_DEFAULT.
#   azure_openai      -> LLM_BASE_URL es el endpoint del recurso, los modelos son
#                        nombres de despliegue y LLM_API_VERSION es obligatoria.
# LLM_PROVIDER=nvidia
# LLM_API_KEY tiene prioridad; NVIDIA_API_KEY se mantiene por compatibilidad.
LLM_API_KEY=
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_VERSION=
# Parámetros propios del proveedor añadidos a cada llamada (objeto JSON; {} = ninguno).
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# --- Modelos: LLM_MODEL_DEFAULT aplica a toda fase que no se indique ---
# LLM_MODEL_DEFAULT=nvidia/nemotron-3-super-120b-a12b
# Calibración de estilo:
# LLM_MODEL_FASE0=
# Análisis del AFU:
# LLM_MODEL_FASE1=
# Code Review:
# LLM_MODEL_FASE1_5=
# Análisis del ABAP:
# LLM_MODEL_FASE2=
# Redacción:
# LLM_MODEL_FASE4=

# --- Documento ---
# PLANTILLA_DTSS_PATH=plantilla_dtss.docx
